# Copy to deploy/.env and adjust. See docs/deploy.md for every variable.

# Where users reach Squawk, without a trailing slash. Cookies are Secure when this is https.
PUBLIC_URL=http://localhost:3000

# At least 32 random characters, e.g. `openssl rand -base64 48`. Signs session cookies.
SESSION_SECRET=change-me-to-at-least-32-random-characters

# OpenID Connect sign-in for the inbox. Leave the client empty to disable sign-in.
OIDC_ISSUER=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ALLOWED_EMAIL_DOMAINS=example.com
OIDC_HOSTED_DOMAIN=

# Page origins whose overlay sign-in popup skips the consent card, comma-separated.
# `*` matches part of one host label or any port, e.g. https://*.preview.example.com,http://localhost:*
SQUAWK_TRUSTED_ORIGINS=

LOG_LEVEL=info

# Trying Squawk on your own machine without an identity provider (docker-compose.yml only):
# every request without credentials then acts as this user. The image sets NODE_ENV=production,
# which refuses SQUAWK_DEV_USER, so both lines go together. Never on a server others can reach.
# NODE_ENV=development
# SQUAWK_DEV_USER=you@example.com

# docker-compose.prod.yml only: the Postgres password, e.g. `openssl rand -hex 24` (hex keeps it
# safe inside the connection URL).
# POSTGRES_PASSWORD=

# docker-compose.caddy.yml only: the hostname Caddy gets a certificate for, the host of PUBLIC_URL.
# SQUAWK_DOMAIN=squawk.example.com

# DATABASE_URL and DATA_DIR are set by the compose files.
