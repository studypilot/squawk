{
   "name": "@studypilot/squawk-cli",
   "version": "0.2.0",
   "description": "Command-line client for Squawk: list, read, answer and resolve squawks from scripts and coding agents.",
   "license": "MIT",
   "type": "module",
   "engines": {
      "node": ">=22"
   },
   "bin": {
      "squawk": "./dist/main.js"
   },
   "files": [
      "dist",
      "README.md"
   ],
   "publishConfig": {
      "registry": "https://npm.pkg.github.com"
   },
   "scripts": {
      "dev": "tsx src/main.ts",
      "build": "node build.mjs",
      "typecheck": "tsc --noEmit",
      "test": "vitest run"
   },
   "devDependencies": {
      "@squawk/shared": "workspace:*",
      "commander": "^14.0.3",
      "esbuild": "^0.28.2",
      "tsx": "^4.20.0",
      "zod": "^4.6.6"
   }
}
