{
   "name": "@studypilot/squawk-cli",
   "version": "0.1.0",
   "description": "Command-line client for Squawk: list, read, answer and resolve squawks from scripts and coding agents.",
   "license": "MIT",
   "type": "module",
   "bin": { "squawk": "./dist/main.js" },
   "files": ["dist", "README.md"],
   "publishConfig": { "registry": "https://npm.pkg.github.com" },
   "scripts": {
      "dev": "tsx src/main.ts",
      "build": "tsc -p tsconfig.build.json",
      "typecheck": "tsc --noEmit",
      "test": "vitest run"
   },
   "dependencies": {
      "commander": "^14.0.0"
   },
   "devDependencies": {
      "@squawk/shared": "workspace:*",
      "tsx": "^4.20.0",
      "zod": "^4.1.0"
   }
}
